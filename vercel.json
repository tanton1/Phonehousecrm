{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/telegram/scan-operations",
      "schedule": "5 1 * * *"
    },
    {
      "path": "/api/telegram/scan-attendance-afternoon",
      "schedule": "10 7 * * *"
    },
    {
      "path": "/api/telegram/scan-attendance-evening",
      "schedule": "10 10 * * *"
    }
  ]
}
