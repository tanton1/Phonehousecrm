# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Firebase Admin service-account JSON (server-side only, never prefix with VITE_).
# Required on Vercel/hosts without Google Application Default Credentials.
FIREBASE_SERVICE_ACCOUNT_JSON='{"type":"service_account","project_id":"..."}'
FIRESTORE_DATABASE_ID="ai-studio-iphoneshopcrmbui-b0e785b1-25cf-4fc4-b7b5-9795da0731f7"

# Server-only key used to encrypt repair-device passcodes (minimum 32 random characters).
# Generate a unique value per environment; never expose it with a VITE_ prefix.
TECHNICAL_SECRET_ENCRYPTION_KEY="REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS"

# Telegram Bot API (Server-side Secret Only - Tuyệt đối không dùng tiền tố VITE_)
TELEGRAM_BOT_TOKEN="MY_TELEGRAM_BOT_TOKEN"
TELEGRAM_CHAT_ID="MY_TELEGRAM_CHAT_ID"

# Pancake / Omnichannel Webhook Secret (Xác thực nguồn gửi từ Pancake/Meta)
PANCAKE_WEBHOOK_SECRET="MY_PANCAKE_WEBHOOK_SECRET"
# Page phonehousech109. Token lấy tại Pancake > Cài đặt > Công cụ.
PANCAKE_PAGE_ACCESS_TOKEN=""
PANCAKE_PAGE_ID="332799593244601"
PANCAKE_PAGE_NAME="phonehousech109"
PANCAKE_BRANCH_NAME="Phonehouse"
PANCAKE_HISTORY_DAYS="30"
PANCAKE_INCLUDE_COMMENTS="true"
# Nhiều Page: dùng PANCAKE_PAGES_JSON và tokenEnv riêng cho từng Page.
# PANCAKE_PAGES_JSON='[{"pageId":"332799593244601","pageName":"phonehousech109","branchName":"Phonehouse","historyDays":30,"includeComments":true,"tokenEnv":"PANCAKE_PAGE_ACCESS_TOKEN"}]'

# Meta Messenger Platform (server-side only, kết nối trực tiếp không qua Pancake).
CHAT_PROVIDER="meta"
META_APP_ID=""
META_APP_SECRET=""
META_PAGE_ID="332799593244601"
META_PAGE_NAME="phonehousech109"
META_PAGE_ACCESS_TOKEN=""
META_WEBHOOK_VERIFY_TOKEN=""
# Ưu tiên document ID thật của chi nhánh. Nếu để trống, hệ thống dùng ánh xạ Page Pancake hiện có.
META_BRANCH_ID=""
# Ghim phiên bản API đã kiểm thử; không dùng tiền tố VITE_ cho bất kỳ secret nào ở trên.
META_GRAPH_API_VERSION="v23.0"
META_SYNC_DAYS="30"
# Khóa mã hóa token của nhiều Page (khuyến nghị 32+ ký tự ngẫu nhiên).
# Nếu để trống hệ thống tạm dùng META_APP_SECRET làm nguồn tạo khóa.
CHANNEL_TOKEN_ENCRYPTION_KEY=""
# Phải thêm chính xác URL này vào Meta > Facebook Login > Valid OAuth Redirect URIs.
META_OAUTH_REDIRECT_URI="https://phonehousedn.vercel.app/api/channel-connections/meta/oauth/callback"
