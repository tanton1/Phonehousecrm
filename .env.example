# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"
# Optional model override for image/audio capture (defaults to GEMINI_MODEL or gemini-2.5-flash).
GEMINI_CAPTURE_MODEL="gemini-2.5-flash"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Firebase Admin service-account JSON (server-side only, never prefix with VITE_).
# Required on Vercel/hosts without Google Application Default Credentials.
FIREBASE_SERVICE_ACCOUNT_JSON='{"type":"service_account","project_id":"..."}'
FIRESTORE_DATABASE_ID="ai-studio-iphoneshopcrmbui-b0e785b1-25cf-4fc4-b7b5-9795da0731f7"

# Server-only key used to encrypt repair-device passcodes (minimum 32 random characters).
# Generate a unique value per environment; never expose it with a VITE_ prefix.
TECHNICAL_SECRET_ENCRYPTION_KEY="REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS"

# Telegram Bot API (Server-side Secret Only - Tuyệt đối không dùng tiền tố VITE_)
TELEGRAM_BOT_TOKEN="MY_TELEGRAM_BOT_TOKEN"
TELEGRAM_CHAT_ID="MY_TELEGRAM_CHAT_ID"
# Secret gửi khi đăng ký setWebhook và được Telegram trả lại trong header.
TELEGRAM_WEBHOOK_SECRET="REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS"
# Telegram user ID của chủ hệ thống được phép xem phạm vi "all", phân cách bằng dấu phẩy.
TELEGRAM_OWNER_USER_IDS=""
TELEGRAM_ALERTS_ENABLED="true"
TELEGRAM_QUERIES_ENABLED="true"
# Secret cho Cloud Scheduler/Vercel Cron gọi quét nhân viên chưa vào ca và retry outbox.
ATTENDANCE_ALERT_CRON_SECRET="REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS"
# URL Production cố định dùng khi đăng ký Telegram webhook.
PHONEHOUSE_PUBLIC_URL="https://phonehousedn.vercel.app"

# Danh sách origin frontend được gọi API, phân cách bằng dấu phẩy.
CORS_ALLOWED_ORIGINS="https://phonehousedn.vercel.app"

# Distributed rate limiting (recommended in production). Create a Redis database
# in Upstash/Vercel Marketplace and copy its REST credentials.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
# Vercel KV may expose the equivalent KV_REST_API_URL/KV_REST_API_TOKEN names.

# Firebase App Check: register the production web app with reCAPTCHA Enterprise,
# bind the public site key to the production domain, then enable enforcement only
# after token verification succeeds in production.
APP_CHECK_ENFORCED="false"
# Public reCAPTCHA Enterprise site key used by the browser (this is not a secret).
VITE_FIREBASE_APPCHECK_SITE_KEY=""

# PhoneHouse Care customer PWA. Enable Phone provider in Firebase Authentication.
# Public Web Push certificate key from Firebase Console > Project Settings > Cloud Messaging.
VITE_FIREBASE_MESSAGING_VAPID_KEY=""

# Server-only AES key for public quick-quote selection tokens. Use at least
# 32 random characters. Never expose this value with a VITE_ prefix.
QUICK_QUOTE_TOKEN_KEY="REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS"

# Optional generic error intake (Sentry-compatible relay, Slack/Teams workflow,
# or your own monitoring endpoint). Receives sanitized server/client error JSON.
OBSERVABILITY_WEBHOOK_URL=""
# Set only in protected debugging environments; production server maps are off by default.
GENERATE_SERVER_SOURCEMAP="false"

# Backup automation inputs for scripts/backup-firestore.ps1.
FIREBASE_PROJECT_ID="gen-lang-client-0344640799"
FIRESTORE_BACKUP_BUCKET="gs://REPLACE_WITH_BACKUP_BUCKET/phonehouse-firestore"

# Pancake / Omnichannel Webhook Secret (Xác thực nguồn gửi từ Pancake/Meta)
PANCAKE_WEBHOOK_SECRET="MY_PANCAKE_WEBHOOK_SECRET"
# Page phonehousech109. Token lấy tại Pancake > Cài đặt > Công cụ.
PANCAKE_PAGE_ACCESS_TOKEN=""
PANCAKE_PAGE_ID="332799593244601"
PANCAKE_PAGE_NAME="phonehousech109"
PANCAKE_BRANCH_NAME="Phonehouse"
PANCAKE_HISTORY_DAYS="30"
PANCAKE_INCLUDE_COMMENTS="true"
# Nhiều Page: dùng PANCAKE_PAGES_JSON và tokenEnv riêng cho từng Page.
# PANCAKE_PAGES_JSON='[{"pageId":"332799593244601","pageName":"phonehousech109","branchName":"Phonehouse","historyDays":30,"includeComments":true,"tokenEnv":"PANCAKE_PAGE_ACCESS_TOKEN"}]'

# Meta Messenger Platform (server-side only, kết nối trực tiếp không qua Pancake).
CHAT_PROVIDER="meta"
META_APP_ID=""
META_APP_SECRET=""
META_PAGE_ID="332799593244601"
META_PAGE_NAME="phonehousech109"
META_PAGE_ACCESS_TOKEN=""
META_WEBHOOK_VERIFY_TOKEN=""
# Ưu tiên document ID thật của chi nhánh. Nếu để trống, hệ thống dùng ánh xạ Page Pancake hiện có.
META_BRANCH_ID=""
# Ghim phiên bản API đã kiểm thử; không dùng tiền tố VITE_ cho bất kỳ secret nào ở trên.
META_GRAPH_API_VERSION="v23.0"
META_SYNC_DAYS="30"
# Khóa mã hóa token của nhiều Page (khuyến nghị 32+ ký tự ngẫu nhiên).
# Nếu để trống hệ thống tạm dùng META_APP_SECRET làm nguồn tạo khóa.
CHANNEL_TOKEN_ENCRYPTION_KEY=""
# Phải thêm chính xác URL này vào Meta > Facebook Login > Valid OAuth Redirect URIs.
META_OAUTH_REDIRECT_URI="https://phonehousedn.vercel.app/api/channel-connections/meta/oauth/callback"

# Zalo Official Account (server-side only). Có thể nhập theo từng OA trong trang Kênh & Kết nối.
# Biến bên dưới là giá trị dự phòng dùng chung cho nhiều OA thuộc cùng một Zalo App.
ZALO_APP_ID=""
ZALO_APP_SECRET=""
# Khóa dùng xác thực X-ZEvent-Signature; có thể lưu riêng cho từng OA trên giao diện.
ZALO_OA_SECRET_KEY=""
# Webhook khai báo tại Zalo Developers: https://phonehousedn.vercel.app/api/zalo/webhook

# TikTok Business Messaging API (server-side only).
# Tạo app tại TikTok API for Business, xin Business Messaging API và tạo Authorization URL trong Portal.
TIKTOK_APP_ID=""
TIKTOK_APP_SECRET=""
# Dán nguyên Authorization URL do TikTok Developer Portal sinh ra.
TIKTOK_AUTHORIZATION_URL=""
# Phải khai báo đúng URL này trong TikTok app.
TIKTOK_OAUTH_REDIRECT_URI="https://phonehousedn.vercel.app/api/channel-connections/tiktok/oauth/callback"
# Webhook sẽ được server đăng ký tự động: https://phonehousedn.vercel.app/api/tiktok/webhook
