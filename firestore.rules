rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================================
    // HELPER FUNCTIONS & AUTHENTICATION / PERMISSION INVARIANTS
    // ============================================================

    // 1. Basic Authentication Check
    function isAuthenticated() {
      return request.auth != null;
    }

    // 2. Self check (User modifying own profile)
    function isSelf(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // 3. User Data & Active User Invariant Check (Single Source of Truth)
    function userExists() {
      return isAuthenticated() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isActiveUser() {
      return userExists() &&
        getUserData().active == true &&
        (!('mustChangePassword' in getUserData()) || getUserData().mustChangePassword != true);
    }

    function getUserRole() {
      return userExists() ? getUserData().role : '';
    }

    function getUserBranch() {
      return userExists() ? getUserData().branchId : '';
    }

    function hasRole(role) {
      return userExists() && getUserData().role == role;
    }

    // 4. Role Hierarchy Check (Guarded strictly by isActiveUser & Single Source of Truth from Firestore)
    function isAdmin() {
      return isActiveUser() && getUserRole() == 'ADMIN';
    }

    function isManager() {
      return isAdmin() || (
        isActiveUser() && (
          getUserRole() == 'MANAGER' ||
          getUserRole() == 'STORE_MANAGER' ||
          getUserRole() == 'REGIONAL_MANAGER'
        )
      );
    }

    function canManageInventory() {
      return isAdmin() || isManager() || (isActiveUser() && hasRole('INVENTORY_MANAGER'));
    }

    function canManageTechnicalStock() {
      return isAdmin() || isManager() || (isActiveUser() && (hasRole('TECH_LEAD') || hasRole('TECH') || hasRole('TECHNICIAN')));
    }

    function canViewCost() {
      return isAdmin() || isManager() || (isActiveUser() && hasRole('ACCOUNTANT'));
    }

    function canReadFinance() {
      return canViewCost();
    }

    function canReadPayroll() {
      return canViewCost();
    }

    // Browser-readable operational documents are explicitly role-scoped.
    // API endpoints remain the source for redacted or server-authoritative views.
    function canReadInvoices() {
      return isAdmin() || (
        isActiveUser() && getUserRole() in [
          'REGIONAL_MANAGER', 'MANAGER', 'STORE_MANAGER',
          'SALES', 'SALE', 'SALE_ONLINE', 'CUSTOMER_CARE', 'CSKH', 'CASHIER',
          'ACCOUNTANT', 'INVENTORY_MANAGER', 'WAREHOUSE'
        ]
      );
    }

    function canReadCrm() {
      return isAdmin() || (
        isActiveUser() && getUserRole() in [
          'REGIONAL_MANAGER', 'MANAGER', 'STORE_MANAGER',
          'SALES', 'SALE', 'SALE_ONLINE', 'CUSTOMER_CARE', 'CSKH'
        ]
      );
    }

    function canReadTradeIns() {
      return isAdmin() || (
        isActiveUser() && getUserRole() in [
          'REGIONAL_MANAGER', 'MANAGER', 'STORE_MANAGER',
          'SALES', 'SALE', 'SALE_ONLINE',
          'TECH_LEAD', 'TECH', 'TECHNICIAN', 'INVENTORY_MANAGER', 'WAREHOUSE'
        ]
      );
    }

    function canReadPartnerDirectory() {
      return isAdmin() || (
        isActiveUser() && getUserRole() in [
          'REGIONAL_MANAGER', 'MANAGER', 'STORE_MANAGER',
          'SALES', 'SALE', 'SALE_ONLINE', 'CUSTOMER_CARE', 'CSKH', 'CASHIER',
          'ACCOUNTANT', 'INVENTORY_MANAGER', 'WAREHOUSE'
        ]
      );
    }

    // 5. Multi-tenant Branch Isolation (Requires active user)
    function canAccessBranch(branchId) {
      return isAdmin() || (
        isActiveUser() &&
        branchId is string &&
        branchId.size() > 0 && (
          branchId == getUserBranch() ||
          ('assignedBranchIds' in getUserData() && branchId in getUserData().assignedBranchIds)
        )
      );
    }

    // ============================================================
    // COLLECTION-SPECIFIC SECURITY RULES (V4.1 ENTERPRISE SERVER AUTHORITY)
    // ============================================================

    // 1. Users Management (Role escalation protection & strictly immutable privilege fields)
    match /users/{userId} {
      allow read: if (isSelf(userId) && isActiveUser()) || isAdmin() || (isManager() && canAccessBranch(resource.data.branchId));
      allow write: if false; // Only /api/users via Admin SDK.
    }

    // 2. Global Enterprise Settings, Branches & Warehouses
    match /storeSettings/{docId} {
      allow read: if isAuthenticated() && isActiveUser();
      allow write: if false; // Only /api/configuration via Admin SDK.
    }

    match /branches/{branchId} {
      allow read: if isAuthenticated() && isActiveUser();
      allow write: if false; // Only /api/configuration via Admin SDK.
    }

    match /warehouses/{warehouseId} {
      allow read: if isAuthenticated() && isActiveUser();
      allow write: if false; // Strict Single Writer: Only Configuration API via Admin SDK
    }

    // 3. Operational Collections - Strict Server Authority Protection
    // DEVICES: Sensitive state machine (status, sellPrice, branchId, soldInvoiceId, reservedUntil) is Server Authoritative Only!
    match /devices/{deviceId} {
      // Operational clients use /api/inventory/devices, which redacts cost by role.
      // Firestore cannot redact individual fields, so raw reads are cost-authorized only.
      allow read: if canViewCost() && canAccessBranch(resource.data.branchId);
      allow create: if false; // IMEI registry + cost opening entry must be created by the Inventory API transaction.
      allow update: if false; // Metadata and state transitions are server-only.
      allow delete: if false; // Cancellation/reversal must also release imeiRegistry on the server.
    }

    // Canonical IMEI registry and write idempotency are server-only invariants.
    match /imeiRegistry/{registryId} {
      allow read, write: if false;
    }

    match /inventoryDeviceIdempotency/{requestId} {
      allow read, write: if false;
    }

    // INVOICES: Strict Single Writer Principle (Only Server Atomic Transaction via Admin SDK)
    match /invoices/{invoiceId} {
      allow read: if canReadInvoices() && canAccessBranch(resource.data.branchId);
      allow write: if false;
    }

    // LEADS: Status transition, assignment & WON linkage are Server Authoritative Only via /api/crm/leads/transition
    match /leads/{leadId} {
      allow read: if canReadCrm() && canAccessBranch(resource.data.branchId);
      allow write: if false; // Tạo, chăm sóc, phân công và chuyển trạng thái chỉ qua /api/crm.
    }

    match /tradeIns/{tradeInId} {
      allow read: if canReadTradeIns() && canAccessBranch(resource.data.branchId);
      allow write: if false; // Hồ sơ, trạng thái và giá duyệt chỉ qua /api/trade-ins.
    }

    match /tradeInAppraisals/{appraisalId} {
      allow read: if canReadTradeIns() && canAccessBranch(resource.data.branchId);
      allow write: if false; // Strict Single Writer: Only Server POS & Appraisal Engine
    }

    match /warrantyTickets/{ticketId} {
      allow read: if (isManager() && canAccessBranch(resource.data.branchId)) || (
        isActiveUser() && resource.data.assigneeId == request.auth.uid && canAccessBranch(resource.data.branchId)
      );
      allow write: if false; // Legacy compatibility view only; new repairs use the Technical API.
    }

    match /partners/{partnerId} {
      allow read: if canReadPartnerDirectory() && canAccessBranch(resource.data.branchId);
      allow write: if false; // Metadata via /api/partners; debt only via accounting services.
    }

    // Shared identity contains system-wide PII and is resolved only by the API.
    // A branch must never enumerate identities belonging to another branch.
    match /partyMasters/{partyMasterId} {
      allow read, write: if false;
    }

    match /branchPartyAccounts/{accountId} {
      allow read: if canReadFinance() && canAccessBranch(resource.data.branchId);
      allow write: if false;
    }

    match /debtLedgerEntries/{entryId} {
      allow read: if canViewCost() && canAccessBranch(resource.data.branchId);
      allow write: if false;
    }

    match /debtOpenItems/{itemId} {
      allow read: if canReadFinance() && canAccessBranch(resource.data.branchId);
      allow write: if false;
    }

    match /partnerDebtSettlements/{settlementId} {
      allow read: if canViewCost() && canAccessBranch(resource.data.branchId);
      allow write: if false;
    }

    match /partnerDebtSettlementRequests/{requestId} {
      allow read, write: if false;
    }

    match /installmentDisbursements/{disbursementId} {
      allow read: if canViewCost() && canAccessBranch(resource.data.branchId);
      allow write: if false;
    }

    match /installmentDisbursementRequests/{requestId} {
      allow read, write: if false;
    }

    match /invoiceEvents/{eventId} {
      allow read: if isAuthenticated() && isActiveUser() && canAccessBranch(resource.data.branchId);
      allow write: if false;
    }

    // 4. Inventory, Warehouse Transfers & Stock Balances (Server Authoritative Writes)
    match /inventoryBalances/{balanceId} {
      allow read: if isAuthenticated() && canAccessBranch(resource.data.branchId);
      allow write: if false; // Strict Single Writer: Only Server POS Checkout / Inventory Transfer via Admin SDK
    }

    match /branchProducts/{branchProductId} {
      allow read: if isAuthenticated() && canAccessBranch(resource.data.branchId);
      allow write: if false;
    }

    match /transfers/{transferId} {
      allow read: if isAuthenticated() && (
        isAdmin() || 
        canAccessBranch(resource.data.sourceBranchId) || 
        canAccessBranch(resource.data.destinationBranchId) ||
        canAccessBranch(resource.data.branchId)
      );
      allow write: if false; // Single Writer: /api/inventory-transfers transaction only
    }

    match /stockIssues/{issueId} {
      allow read: if isAuthenticated() && isActiveUser() && canAccessBranch(resource.data.branchId);
      allow write: if false;
    }

    match /stockReceipts/{receiptId} {
      allow read: if isAuthenticated() && isActiveUser() && (
        canAccessBranch(resource.data.branchId) || canAccessBranch(resource.data.sourceBranchId)
      );
      allow write: if false;
    }

    match /interBranchLedger/{entryId} {
      allow read: if isAuthenticated() && isActiveUser() && (
        isAdmin() || canAccessBranch(resource.data.sourceBranchId) || canAccessBranch(resource.data.destinationBranchId)
      );
      allow write: if false; // One balanced entry, never two client-written debts
    }

    match /interBranchSettlements/{settlementId} {
      allow read: if isAuthenticated() && isActiveUser() && (
        isAdmin() || canAccessBranch(resource.data.payerBranchId) || canAccessBranch(resource.data.receiverBranchId)
      );
      allow write: if false; // Server atomically updates both funds, both cash entries and the debt.
    }

    match /interBranchSettlementIdempotency/{keyId} {
      allow read, write: if false;
    }

    match /inventoryTransferIdempotency/{keyId} {
      allow read, write: if false;
    }

    match /technicalTaskTypes/{taskTypeId} {
      allow read: if isAuthenticated() && isActiveUser();
      allow write: if false; // Versioned configuration is maintained by an Admin API
    }

    match /purchaseOrders/{orderId} {
      allow read: if isAuthenticated() && canAccessBranch(resource.data.branchId);
      allow write: if false; // Receipt, payment, cancellation and notes are server-only.
    }

    match /purchaseOrderEvents/{eventId} {
      allow read, write: if false;
    }

    match /purchaseOrderSequences/{sequenceId} {
      allow read, write: if false;
    }

    match /purchasePaymentIdempotency/{operationId} {
      allow read, write: if false;
    }

    match /products/{productId} {
      // Product documents contain global price/cost projections. Browser
      // screens consume the role-redacted, branch/location-scoped inventory
      // API instead of receiving these documents directly.
      allow read, write: if false;
    }

    match /spareParts/{partId} {
      // KTV reads the redacted canonical projection through /api/technical/parts.
      allow read: if canViewCost() && canAccessBranch(resource.data.branchId);
      allow write: if false; // Stock and cost are server-authoritative through Part Ledger APIs.
    }

    match /repairServices/{serviceId} {
      allow read: if isAuthenticated() && isActiveUser();
      allow write: if false; // Only /api/configuration/repair-services.
    }

    // 5. Financial Funds & Cash Transactions: Strict Single Writer Principle
    match /funds/{fundId} {
      allow read: if canReadFinance() && canAccessBranch(resource.data.branchId);
      allow write: if false; // Strict Single Writer: Only Server Finance API (/api/finance/...) via Admin SDK
    }

    match /cashTransactions/{txId} {
      allow read: if canReadFinance() && canAccessBranch(resource.data.branchId);
      allow write: if false; // Strict Single Writer: Only Server Finance API (/api/finance/...) via Admin SDK
    }

    // 6. Omnichannel Chat & Communication (Branch & Participant Scoped)
    match /chatConversations/{convoId} {
      allow read: if isAuthenticated() && (
        isAdmin() ||
        canAccessBranch(resource.data.branchId) ||
        resource.data.assignedUserId == request.auth.uid ||
        (resource.data.participantIds is list && request.auth.uid in resource.data.participantIds)
      );
      allow write: if false; // Server-only: webhook, sync, send and read-state APIs.
    }

    match /chatMessages/{messageId} {
      allow read: if isAuthenticated() && (isAdmin() || canAccessBranch(resource.data.branchId));
      allow write: if false;
    }

    match /pancakeSendOperations/{operationId} {
      allow read, write: if false;
    }

    match /metaSendOperations/{operationId} {
      allow read, write: if false;
    }

    match /chatConversationEvents/{eventId} {
      allow read: if isAuthenticated() && (isAdmin() || canAccessBranch(resource.data.branchId));
      allow write: if false; // Server-only immutable workflow audit trail.
    }

    match /pancakePageMappings/{pageId} {
      allow read, write: if false; // Server-only Page → branch mapping.
    }

    match /metaPageMappings/{pageId} {
      allow read, write: if false; // Server-only Meta Page → branch mapping and webhook health.
    }

    match /zaloOaMappings/{oaId} {
      allow read, write: if false; // Server-only Zalo OA → branch mapping and webhook health.
    }

    match /zaloSendOperations/{operationId} {
      allow read, write: if false; // Server-only idempotency for outbound Zalo messages.
    }

    match /tiktokBusinessMappings/{businessId} {
      allow read, write: if false; // Server-only TikTok Business → branch mapping and webhook health.
    }

    match /tiktokSendOperations/{operationId} {
      allow read, write: if false; // Server-only idempotency for outbound TikTok messages.
    }

    match /channelConnections/{connectionId} {
      allow read, write: if false; // Token và cấu hình nhiều Page chỉ đi qua API server.
    }

    match /channelOAuthStates/{stateId} {
      allow read, write: if false;
    }

    match /channelOAuthSessions/{sessionId} {
      allow read, write: if false;
    }

    match /channelConnectionEvents/{eventId} {
      allow read, write: if false;
    }

    // 7. Attendance & Human Resources (Strict Server Authority writes; employees read own records)
    match /attendance/{attId} {
      allow read: if isAdmin() || (isManager() && canAccessBranch(resource.data.branchId)) || (isAuthenticated() && isActiveUser() && resource.data.staffId == request.auth.uid);
      allow write: if false; // Strict Single Writer Principle: Only Server Attendance API (/api/attendance/...) via Admin SDK
    }

    match /attendanceVerificationSessions/{sessionId} {
      allow read, write: if false;
    }

    match /evidenceUploadSessions/{sessionId} {
      allow read, write: if false;
    }

    match /evidenceRecords/{evidenceId} {
      allow read, write: if false;
    }

    match /executiveDailyAggregates/{aggregateId} {
      allow read, write: if false;
    }

    match /telegramWebhookUpdates/{updateId} {
      allow read, write: if false;
    }

    match /telegramOutboxEvents/{eventId} {
      allow read, write: if false;
    }

    match /telegramQueryAudit/{eventId} {
      allow read, write: if false;
    }

    match /telegramRateLimits/{rateId} {
      allow read, write: if false;
    }

    match /telegramConfigurations/{configurationId} {
      allow read, write: if false; // Bot token và webhook secret chỉ được giải mã trong API server.
    }

    match /inventoryDeviceTombstones/{deviceId} {
      allow read: if canViewCost() && canAccessBranch(resource.data.branchId);
      allow write: if false;
    }

    match /telegramUserLinks/{linkId} {
      allow read, write: if false; // Ánh xạ Telegram ↔ CRM chỉ được xử lý trong API server.
    }

    match /telegramLinkCodes/{codeId} {
      allow read, write: if false; // Mã dùng một lần, hash và hết hạn ở server.
    }

    match /telegramUserBindings/{uid} {
      allow read, write: if false; // Ràng buộc 1 CRM user ↔ 1 Telegram account ở server.
    }

    match /telegramUserPreferences/{preferenceId} {
      allow read, write: if false; // Chi nhánh mặc định của bot chỉ do API Telegram quản lý.
    }

    match /telegramConversationContexts/{contextId} {
      allow read, write: if false; // Ngữ cảnh ngắn hạn của bot không được lộ cho trình duyệt.
    }

    match /attendanceLocationState/{attendanceId} {
      allow read, write: if false;
    }

    match /weeklyShiftSchedules/{scheduleId} {
      allow read: if isAuthenticated() && (isAdmin() || canAccessBranch(resource.data.branchId) || resource.data.staffId == request.auth.uid);
      allow write: if false; // Server-only: /api/attendance/shift-board validates branch, staff and shift snapshots.
    }

    match /shiftDefinitions/{shiftId} {
      allow read, write: if false; // Managed only through the authenticated attendance API.
    }

    match /shiftScheduleAuditLogs/{auditId} {
      allow read, write: if false;
    }

    match /shiftScheduleOperations/{operationId} {
      allow read, write: if false;
    }

    match /shiftDepartmentPolicies/{policyId} {
      allow read, write: if false;
    }

    match /payrollRuns/{runId} {
      allow read, write: if false; // Server-only payroll calculation and approval snapshots.
    }

    match /payrollRunItems/{itemId} {
      allow read, write: if false;
    }

    match /payrollAuditLogs/{auditId} {
      allow read, write: if false;
    }

    match /employmentCompensations/{compensationId} {
      allow read, write: if false; // Effective-dated compensation is exposed only through Payroll API.
    }

    match /compensationAuditLogs/{auditId} {
      allow read, write: if false;
    }

    match /payrollStaffLocks/{lockId} {
      allow read, write: if false; // Prevents one employee from being approved in overlapping runs.
    }

    match /payrollPeriods/{periodId} {
      allow read, write: if false; // Source-domain locks are enforced by server transactions.
    }

    match /payrollAdjustments/{adjustmentId} {
      allow read, write: if false; // Earnings and deductions are server-authoritative.
    }

    match /payrollAdjustmentAuditLogs/{auditId} {
      allow read, write: if false;
    }

    match /payrollPaymentBatches/{batchId} {
      allow read, write: if false;
    }

    match /payrollPaymentRequests/{requestId} {
      allow read, write: if false;
    }

    match /sopTemplates/{templateId} {
      allow read: if isAuthenticated() && isActiveUser();
      allow write: if false; // Only /api/configuration/sop-templates.
    }

    match /dailyShiftChecklists/{checklistId} {
      allow read: if isAdmin() || (isManager() && canAccessBranch(resource.data.branchId)) || (isActiveUser() && resource.data.staffId == request.auth.uid);
      allow write: if false; // Only /api/attendance/checklists.
    }

    match /leaveRequests/{requestId} {
      allow read: if isAdmin() || (isManager() && canAccessBranch(resource.data.branchId)) || (isActiveUser() && resource.data.staffId == request.auth.uid);
      allow write: if false; // Create/review only through /api/attendance.
    }

    match /shiftHandover/{handoverId} {
      allow read: if isAdmin() || (isManager() && canAccessBranch(resource.data.branchId)) || (isActiveUser() && resource.data.staffId == request.auth.uid);
      allow write: if false; // Create/review only through /api/attendance/handovers.
    }

    match /catalogItems/{itemId} {
      allow read: if isAuthenticated() && isActiveUser();
      // Product Master is written only through /api/catalog.  The API claims
      // a normalized SKU registry in the same server-side operation; allowing
      // browser writes here would re-introduce duplicate SKU race conditions.
      allow write: if false;
    }

    // Master data and unique-SKU registry are deliberately server-authoritative.
    // They are not inventory balances; keeping them out of the client SDK also
    // prevents users from bypassing the deterministic SKU engine.
    match /catalogModels/{modelId} {
      allow read: if isAuthenticated() && isActiveUser();
      allow write: if false;
    }

    match /catalogDictionaries/{dictionaryId} {
      allow read: if isAuthenticated() && isActiveUser();
      allow write: if false;
    }

    match /catalogSkuRegistry/{skuId} {
      allow read, write: if false;
    }

    match /catalogModelCodeRegistry/{modelCodeId} {
      allow read, write: if false;
    }

    match /catalogBulkOperations/{operationId} {
      allow read, write: if false;
    }

    // 8. Verifiable CRM Collections (Lead Care Activities, Appointments, Quotes, Evidence, Customer Ledger)
    match /leadCareActivities/{activityId} {
      allow read: if isAdmin() || (
        isActiveUser() && (canAccessBranch(resource.data.branchId) || resource.data.staffId == request.auth.uid)
      );
      allow write: if false;
    }

    match /leadAppointments/{apptId} {
      allow read: if isAdmin() || (
        isActiveUser() && (canAccessBranch(resource.data.branchId) || resource.data.assignedStaffId == request.auth.uid || resource.data.staffId == request.auth.uid)
      );
      allow write: if false;
    }

    match /leadQuotes/{quoteId} {
      allow read: if isAdmin() || (
        isActiveUser() && (canAccessBranch(resource.data.branchId) || resource.data.staffId == request.auth.uid)
      );
      allow write: if false;
    }

    match /leadEvidence/{evidenceId} {
      allow read: if isAdmin() || (isActiveUser() && canAccessBranch(resource.data.branchId));
      allow write: if false;
    }

    match /crmOperations/{operationId} {
      allow read, write: if false;
    }

    match /crmPhoneRegistry/{phoneId} {
      allow read, write: if false;
    }

    match /crmCustomerProfiles/{customerId} {
      allow read, write: if false; // Hồ sơ 360 chỉ trả qua API có kiểm tra chi nhánh/quyền sở hữu.
    }

    match /leadAssignmentHistory/{historyId} {
      allow read: if isAdmin() || (
        isManager() && resource.data.branchId is string && canAccessBranch(resource.data.branchId)
      );
      allow write: if false;
    }

    match /customerActivities/{activityId} {
      allow read: if isAdmin() || (
        isActiveUser() && (canAccessBranch(resource.data.branchId) || resource.data.staffId == request.auth.uid)
      );
      allow write: if false; // Strict Single Writer Principle: Only Server CRM Event Service (/api/crm/...) via Admin SDK
    }

    match /deviceReservations/{reservationId} {
      allow read: if isAdmin() || (isActiveUser() && canAccessBranch(resource.data.branchId));
      allow write: if false; // Strict Single Writer Principle: Only Server Reservation API (/api/crm/quotes/reserve) via Admin SDK
    }

    match /crmTasks/{taskId} {
      allow read: if isAdmin() || (
        isActiveUser() && (canAccessBranch(resource.data.branchId) || resource.data.assignedStaffId == request.auth.uid)
      );
      allow write: if false; // Strict Single Writer Principle: Only Server Event Service via Admin SDK
    }

    // 9. Technical & Work Order Collections (Server-Authoritative Only via /api/technical/...)
    match /technicalWorkOrders/{woId} {
      allow read: if canViewCost() && canAccessBranch(resource.data.branchId);
      allow write: if false; // Strict Single Writer: Only Server Technical API (/api/technical/...)
    }

    match /technicalWorkOrderLines/{lineId} {
      allow read: if canViewCost() && canAccessBranch(resource.data.branchId);
      allow write: if false; // Strict Single Writer: Only Server Technical API
    }

    match /technicalCustodyHandovers/{handoffId} {
      allow read: if canViewCost() && canAccessBranch(resource.data.branchId);
      allow write: if false;
    }

    match /inventoryMovements/{movId} {
      allow read: if canViewCost() && canAccessBranch(resource.data.branchId);
      allow write: if false; // Immutable Audit Ledger: Only Server Admin SDK
    }

    match /qcInspections/{qcId} {
      allow read: if canViewCost() && canAccessBranch(resource.data.branchId);
      allow write: if false; // Strict Single Writer: Only Server Technical QC API
    }

    match /technicalTaskSessions/{sessionId} {
      allow read, write: if false;
    }

    match /technicalQuoteAdjustments/{adjustmentId} {
      allow read, write: if false;
    }

    match /repairPayments/{paymentId} {
      allow read, write: if false;
    }

    match /commissionLedger/{commId} {
      allow read: if isAdmin() || (
        canReadPayroll() && resource.data.branchId is string && canAccessBranch(resource.data.branchId)
      ) || (
        isActiveUser() && resource.data.staffUid == request.auth.uid
      );
      allow write: if false; // Strict Single Writer: Only Server Commission Engine
    }

    match /technicalPartReservations/{resId} {
      allow read: if canViewCost() && canAccessBranch(resource.data.branchId);
      allow write: if false; // Strict Single Writer: Only Server Parts Issue API
    }

    match /technicalPartIssues/{issueId} {
      allow read: if canViewCost() && canAccessBranch(resource.data.branchId);
      allow write: if false;
    }

    match /technicalPartExceptions/{exceptionId} {
      // Requests and approvals are posted through the server so an exception
      // can never be forged in a browser to bypass the task-to-part policy.
      allow read, write: if false;
    }

    match /technicalPartStockRequests/{requestId} {
      allow read, write: if false;
    }

    match /sparePartTransfers/{transferId} {
      allow read, write: if false;
    }

    match /sparePartMovements/{movementId} {
      allow read: if canViewCost() && canAccessBranch(resource.data.branchId);
      allow write: if false;
    }

    match /sparePartReceipts/{receiptId} {
      allow read: if canViewCost() && canAccessBranch(resource.data.branchId);
      allow write: if false;
    }

    match /sparePartLots/{lotId} {
      allow read: if canViewCost() && canAccessBranch(resource.data.branchId);
      allow write: if false;
    }

    match /technicalExternalCosts/{costId} {
      allow read: if canViewCost() && canAccessBranch(resource.data.branchId);
      allow write: if false;
    }

    match /technicalRecoveries/{recoveryId} {
      allow read: if canViewCost() && canAccessBranch(resource.data.branchId);
      allow write: if false;
    }

    match /technicalCostPostings/{postingId} {
      allow read: if canViewCost() && canAccessBranch(resource.data.branchId);
      allow write: if false;
    }

    match /deviceCostEvents/{eventId} {
      allow read: if canViewCost() && canAccessBranch(resource.data.branchId);
      allow write: if false;
    }

    match /deviceFinancials/{deviceId} {
      allow read: if canViewCost() && canAccessBranch(resource.data.branchId);
      allow write: if false;
    }

    match /technicalSecrets/{workOrderId} {
      allow read, write: if false;
    }

    match /technicalOperationIdempotency/{operationId} {
      allow read, write: if false;
    }

    // 10. PhoneHouse Care customer portal collections
    // Customer data is intentionally server-authoritative. The portal uses
    // Firebase Phone Auth only as identity proof; all reads and writes go
    // through /api/customer-portal where ownership and redaction are applied.
    // Explicit denies protect against accidental future broad rules and keep
    // customer PII, repairs, quotes, evidence, chat and push tokens private.
    match /customerAccounts/{accountId} {
      allow read, write: if false;
    }

    match /customerAccountPhoneLinks/{phoneLinkId} {
      allow read, write: if false;
    }

    match /customerAccountPartyLinks/{partyLinkId} {
      allow read, write: if false;
    }

    match /customerServiceRequests/{requestId} {
      allow read, write: if false;
    }

    match /customerQuoteApprovalChallenges/{challengeId} {
      allow read, write: if false;
    }

    match /customerQuoteApprovals/{approvalId} {
      allow read, write: if false;
    }

    match /promotionCampaigns/{promotionId} {
      allow read, write: if false;
    }

    match /customerConversations/{conversationId} {
      allow read, write: if false;
    }

    match /customerMessages/{messageId} {
      allow read, write: if false;
    }

    match /customerNotifications/{notificationId} {
      allow read, write: if false;
    }

    match /customerPushSubscriptions/{subscriptionId} {
      allow read, write: if false;
    }

    match /customerEvidenceUploadSessions/{sessionId} {
      allow read, write: if false;
    }

    match /customerEvidenceRecords/{evidenceId} {
      allow read, write: if false;
    }

    match /customerPortalIdempotency/{operationId} {
      allow read, write: if false;
    }

    // Default fallback is deny-by-default. Admin SDK server calls bypass rules;
    // no browser role, including ADMIN, may bypass a collection's server-only contract.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
