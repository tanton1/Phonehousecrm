rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================================
    // HELPER FUNCTIONS & AUTHENTICATION / PERMISSION INVARIANTS
    // ============================================================

    // 1. Basic Authentication Check
    function isAuthenticated() {
      return request.auth != null;
    }

    // 2. Self check (User modifying own profile)
    function isSelf(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // 3. User Data & Active User Invariant Check (Single Source of Truth)
    function userExists() {
      return isAuthenticated() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isActiveUser() {
      return userExists() && getUserData().active == true;
    }

    function getUserRole() {
      return userExists() ? getUserData().role : '';
    }

    function getUserBranch() {
      return userExists() ? getUserData().branchId : '';
    }

    function hasRole(role) {
      return userExists() && getUserData().role == role;
    }

    // 4. Role Hierarchy Check (Guarded strictly by isActiveUser & Single Source of Truth from Firestore)
    function isAdmin() {
      return isActiveUser() && getUserRole() == 'ADMIN';
    }

    function isManager() {
      return isAdmin() || (
        isActiveUser() && getUserRole() == 'MANAGER'
      );
    }

    function canManageInventory() {
      return isAdmin() || isManager() || (isActiveUser() && hasRole('INVENTORY_MANAGER'));
    }

    function canManageTechnicalStock() {
      return isAdmin() || isManager() || (isActiveUser() && (hasRole('TECH_LEAD') || hasRole('TECH')));
    }

    // 5. Multi-tenant Branch Isolation (Requires active user)
    function canAccessBranch(branchId) {
      return isAdmin() || (
        isActiveUser() &&
        branchId is string &&
        branchId.size() > 0 && (
          branchId == getUserBranch() ||
          ('assignedBranchIds' in getUserData() && branchId in getUserData().assignedBranchIds)
        )
      );
    }

    // ============================================================
    // COLLECTION-SPECIFIC SECURITY RULES (V4.1 ENTERPRISE SERVER AUTHORITY)
    // ============================================================

    // 1. Users Management (Role escalation protection & strictly immutable privilege fields)
    match /users/{userId} {
      allow read: if (isSelf(userId) && isActiveUser()) || isAdmin() || isManager();
      allow create: if false; // Creation must be executed through Admin SDK / Cloud Function / Seed script
      allow update: if isAdmin() || (
        isSelf(userId) &&
        isActiveUser() &&
        request.resource.data.role == resource.data.role &&
        request.resource.data.branchId == resource.data.branchId &&
        request.resource.data.assignedBranchIds == resource.data.assignedBranchIds &&
        request.resource.data.active == resource.data.active
      );
      allow delete: if isAdmin();
    }

    // 2. Global Enterprise Settings, Branches & Warehouses
    match /storeSettings/{docId} {
      allow read: if isAuthenticated() && isActiveUser();
      allow write: if isAdmin();
    }

    match /branches/{branchId} {
      allow read: if isAuthenticated() && isActiveUser();
      allow write: if isAdmin();
    }

    match /warehouses/{warehouseId} {
      allow read: if isAuthenticated() && isActiveUser();
      allow write: if isAdmin();
    }

    // 3. Operational Collections - Strict Server Authority Protection
    // DEVICES: Sensitive state machine (status, sellPrice, branchId, soldInvoiceId, reservedUntil) is Server Authoritative Only!
    match /devices/{deviceId} {
      allow read: if isAuthenticated() && canAccessBranch(resource.data.branchId);
      allow create: if isAuthenticated() && canManageInventory() && canAccessBranch(request.resource.data.branchId);
      allow update: if isAuthenticated() && canManageInventory() &&
        canAccessBranch(resource.data.branchId) && 
        canAccessBranch(request.resource.data.branchId) &&
        request.resource.data.status == resource.data.status &&
        request.resource.data.sellPrice == resource.data.sellPrice &&
        request.resource.data.branchId == resource.data.branchId &&
        (!('soldInvoiceId' in request.resource.data) || request.resource.data.soldInvoiceId == resource.data.soldInvoiceId) &&
        (!('reservedUntil' in request.resource.data) || request.resource.data.reservedUntil == resource.data.reservedUntil);
      allow delete: if isAdmin();
    }

    // INVOICES: Strict Single Writer Principle (Only Server Atomic Transaction via Admin SDK)
    match /invoices/{invoiceId} {
      allow read: if isAuthenticated() && canAccessBranch(resource.data.branchId);
      allow write: if false;
    }

    // LEADS: Status transition, assignment & WON linkage are Server Authoritative Only via /api/crm/leads/transition
    match /leads/{leadId} {
      allow read: if isAuthenticated() && canAccessBranch(resource.data.branchId);
      allow create: if isAuthenticated() && canAccessBranch(request.resource.data.branchId) &&
        request.resource.data.status == 'new';
      allow update: if isAuthenticated() && 
        canAccessBranch(resource.data.branchId) && 
        canAccessBranch(request.resource.data.branchId) &&
        request.resource.data.status == resource.data.status && // Status transitions must go through Server API
        (!('wonInvoiceId' in request.resource.data) || request.resource.data.wonInvoiceId == resource.data.wonInvoiceId) &&
        (!('assignedStaffId' in request.resource.data) || isManager() || request.resource.data.assignedStaffId == resource.data.assignedStaffId);
      allow delete: if isAdmin() || (isManager() && canAccessBranch(resource.data.branchId));
    }

    match /tradeIns/{tradeInId} {
      allow read: if isAuthenticated() && canAccessBranch(resource.data.branchId);
      allow create: if isAuthenticated() && canAccessBranch(request.resource.data.branchId);
      allow update: if isAuthenticated() && 
        canAccessBranch(resource.data.branchId) && 
        canAccessBranch(request.resource.data.branchId) &&
        (!('approvedPrice' in request.resource.data) || isManager() || request.resource.data.approvedPrice == resource.data.approvedPrice);
      allow delete: if isAdmin() || isManager();
    }

    match /tradeInAppraisals/{appraisalId} {
      allow read: if isAuthenticated() && canAccessBranch(resource.data.branchId);
      allow write: if false; // Strict Single Writer: Only Server POS & Appraisal Engine
    }

    match /warrantyTickets/{ticketId} {
      allow read: if isAuthenticated() && canAccessBranch(resource.data.branchId);
      allow create: if isAuthenticated() && canAccessBranch(request.resource.data.branchId);
      allow update: if isAuthenticated() && 
        canAccessBranch(resource.data.branchId) && 
        canAccessBranch(request.resource.data.branchId);
      allow delete: if isAdmin() || isManager();
    }

    match /partners/{partnerId} {
      allow read: if isAuthenticated() && canAccessBranch(resource.data.branchId);
      allow create: if isAuthenticated() && canAccessBranch(request.resource.data.branchId);
      allow update: if isAuthenticated() && 
        canAccessBranch(resource.data.branchId) && 
        canAccessBranch(request.resource.data.branchId);
      allow delete: if isAdmin();
    }

    // 4. Inventory, Warehouse Transfers & Stock Balances (Server Authoritative Writes)
    match /inventoryBalances/{balanceId} {
      allow read: if isAuthenticated() && canAccessBranch(resource.data.branchId);
      allow write: if false; // Strict Single Writer: Only Server POS Checkout / Inventory Transfer via Admin SDK
    }

    match /transfers/{transferId} {
      allow read: if isAuthenticated() && (
        isAdmin() || 
        canAccessBranch(resource.data.sourceBranchId) || 
        canAccessBranch(resource.data.destinationBranchId) ||
        canAccessBranch(resource.data.branchId)
      );
      allow create: if isAuthenticated() && canManageInventory() && (
        canAccessBranch(request.resource.data.sourceBranchId) ||
        canAccessBranch(request.resource.data.branchId)
      );
      allow update: if isAuthenticated() && canManageInventory() && (
        isAdmin() ||
        canAccessBranch(resource.data.sourceBranchId) ||
        canAccessBranch(resource.data.destinationBranchId)
      );
      allow delete: if isAdmin();
    }

    match /purchaseOrders/{orderId} {
      allow read: if isAuthenticated() && canAccessBranch(resource.data.branchId);
      allow create, update: if isAuthenticated() && canManageInventory() && canAccessBranch(request.resource.data.branchId);
      allow delete: if isAdmin();
    }

    match /products/{productId} {
      allow read: if isAuthenticated() && isActiveUser();
      allow create, update: if canManageInventory();
      allow delete: if isAdmin();
    }

    match /spareParts/{partId} {
      allow read: if isAuthenticated() && isActiveUser();
      allow create, update: if canManageTechnicalStock();
      allow delete: if isAdmin();
    }

    match /repairServices/{serviceId} {
      allow read: if isAuthenticated() && isActiveUser();
      allow write: if isAdmin() || isManager();
    }

    // 5. Financial Funds & Cash Transactions: Strict Single Writer Principle
    match /funds/{fundId} {
      allow read: if isAuthenticated() && canAccessBranch(resource.data.branchId);
      allow write: if false; // Strict Single Writer: Only Server Finance API (/api/finance/...) via Admin SDK
    }

    match /cashTransactions/{txId} {
      allow read: if isAuthenticated() && canAccessBranch(resource.data.branchId);
      allow write: if false; // Strict Single Writer: Only Server Finance API (/api/finance/...) via Admin SDK
    }

    // 6. Omnichannel Chat & Communication (Branch & Participant Scoped)
    match /chatConversations/{convoId} {
      allow read: if isAuthenticated() && (
        isAdmin() ||
        canAccessBranch(resource.data.branchId) ||
        resource.data.assignedUserId == request.auth.uid ||
        (resource.data.participantIds is list && request.auth.uid in resource.data.participantIds)
      );
      allow create: if isAuthenticated() && (
        isAdmin() ||
        canAccessBranch(request.resource.data.branchId)
      );
      allow update: if isAuthenticated() && (
        isAdmin() ||
        canAccessBranch(resource.data.branchId) ||
        resource.data.assignedUserId == request.auth.uid
      );
      allow delete: if isAdmin();
    }

    // 7. Attendance & Human Resources (Strict Server Authority writes; employees read own records)
    match /attendance/{attId} {
      allow read: if isAdmin() || isManager() || (isAuthenticated() && isActiveUser() && resource.data.staffId == request.auth.uid);
      allow write: if false; // Strict Single Writer Principle: Only Server Attendance API (/api/attendance/...) via Admin SDK
    }

    match /weeklyShiftSchedules/{scheduleId} {
      allow read: if isAuthenticated() && (isAdmin() || canAccessBranch(resource.data.branchId) || resource.data.staffId == request.auth.uid);
      allow create: if isAdmin() || (
        isManager() &&
        canAccessBranch(request.resource.data.branchId)
      );
      allow update: if isAdmin() || (
        isManager() &&
        canAccessBranch(resource.data.branchId) &&
        canAccessBranch(request.resource.data.branchId) &&
        request.resource.data.staffId == resource.data.staffId &&
        request.resource.data.branchId == resource.data.branchId &&
        request.resource.data.weekStart == resource.data.weekStart
      );
      allow delete: if isAdmin() || (
        isManager() &&
        canAccessBranch(resource.data.branchId)
      );
    }

    match /sopTemplates/{templateId} {
      allow read: if isAuthenticated() && isActiveUser();
      allow write: if isAdmin() || isManager();
    }

    match /shiftHandover/{handoverId} {
      allow read: if isAuthenticated() && isActiveUser();
      allow create: if isAuthenticated() && isActiveUser();
      allow update: if isAdmin() || isManager() || (isAuthenticated() && isActiveUser() && resource.data.staffId == request.auth.uid);
      allow delete: if isAdmin();
    }

    match /catalogItems/{itemId} {
      allow read: if isAuthenticated() && isActiveUser();
      allow write: if isAdmin() || isManager();
    }

    // 8. Verifiable CRM Collections (Lead Care Activities, Appointments, Quotes, Evidence, Customer Ledger)
    match /leadCareActivities/{activityId} {
      allow read: if isAdmin() || (
        isActiveUser() && (canAccessBranch(resource.data.branchId) || resource.data.staffId == request.auth.uid)
      );
      allow create: if isAuthenticated() && isActiveUser() && canAccessBranch(request.resource.data.branchId) && (
        isManager() || (request.resource.data.verificationStatus != 'MANAGER_VERIFIED')
      );
      allow update: if isAuthenticated() && isActiveUser() && (
        (isManager() && canAccessBranch(resource.data.branchId)) || (
          canAccessBranch(resource.data.branchId) &&
          resource.data.staffId == request.auth.uid &&
          resource.data.verificationStatus != 'MANAGER_VERIFIED' &&
          request.resource.data.verificationStatus != 'MANAGER_VERIFIED' &&
          (!('qaReview' in request.resource.data) || request.resource.data.qaReview == resource.data.qaReview)
        )
      );
      allow delete: if isAdmin() || (isManager() && canAccessBranch(resource.data.branchId));
    }

    match /leadAppointments/{apptId} {
      allow read: if isAdmin() || (
        isActiveUser() && (canAccessBranch(resource.data.branchId) || resource.data.assignedStaffId == request.auth.uid || resource.data.staffId == request.auth.uid)
      );
      allow create: if isAuthenticated() && isActiveUser() && canAccessBranch(request.resource.data.branchId);
      allow update: if isAuthenticated() && isActiveUser() && (
        isAdmin() || (isManager() && canAccessBranch(resource.data.branchId)) || (
          canAccessBranch(resource.data.branchId) && (resource.data.assignedStaffId == request.auth.uid || resource.data.staffId == request.auth.uid)
        )
      );
      allow delete: if isAdmin() || (isManager() && canAccessBranch(resource.data.branchId));
    }

    match /leadQuotes/{quoteId} {
      allow read: if isAdmin() || (
        isActiveUser() && (canAccessBranch(resource.data.branchId) || resource.data.staffId == request.auth.uid)
      );
      allow create: if isAuthenticated() && isActiveUser() && canAccessBranch(request.resource.data.branchId);
      allow update: if isAuthenticated() && isActiveUser() && (
        isAdmin() || (isManager() && canAccessBranch(resource.data.branchId)) || (
          canAccessBranch(resource.data.branchId) && resource.data.staffId == request.auth.uid
        )
      );
      allow delete: if isAdmin() || (isManager() && canAccessBranch(resource.data.branchId));
    }

    match /leadEvidence/{evidenceId} {
      allow read: if isAdmin() || (isActiveUser() && canAccessBranch(resource.data.branchId));
      allow create: if isAuthenticated() && isActiveUser() && canAccessBranch(request.resource.data.branchId);
      allow update, delete: if isAdmin() || (isManager() && canAccessBranch(resource.data.branchId));
    }

    match /customerActivities/{activityId} {
      allow read: if isAdmin() || (
        isActiveUser() && (canAccessBranch(resource.data.branchId) || resource.data.staffId == request.auth.uid)
      );
      allow write: if false; // Strict Single Writer Principle: Only Server CRM Event Service (/api/crm/...) via Admin SDK
    }

    match /deviceReservations/{reservationId} {
      allow read: if isAdmin() || (isActiveUser() && canAccessBranch(resource.data.branchId));
      allow write: if false; // Strict Single Writer Principle: Only Server Reservation API (/api/crm/quotes/reserve) via Admin SDK
    }

    match /crmTasks/{taskId} {
      allow read: if isAdmin() || (
        isActiveUser() && (canAccessBranch(resource.data.branchId) || resource.data.assignedStaffId == request.auth.uid)
      );
      allow write: if false; // Strict Single Writer Principle: Only Server Event Service via Admin SDK
    }

    // Default Fallback: Only Active Admin
    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
