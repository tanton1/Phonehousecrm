rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    // Entity Validation: Device
    function isValidDevice(data) {
      return data.id is string &&
        data.model is string &&
        data.imei is string;
    }

    // Entity Validation: Lead
    function isValidLead(data) {
      return data.id is string &&
        data.name is string;
    }

    // Entity Validation: TradeInAppraisal
    function isValidTradeIn(data) {
      return data.id is string &&
        data.customerName is string;
    }

    // Entity Validation: WarrantyTicket
    function isValidWarranty(data) {
      return data.id is string &&
        data.customerName is string;
    }

    // Entity Validation: SalesInvoice
    function isValidInvoice(data) {
      return data.id is string &&
        data.customerName is string;
    }

    // Entity Validation: UserAccount
    function isValidUserAccount(data) {
      return data.id is string &&
        data.displayName is string;
    }

    // Entity Validation: Partner (Customer & Supplier)
    function isValidPartner(data) {
      return data.id is string &&
        data.name is string;
    }

    // Entity Validation: CashTransaction
    function isValidCashTransaction(data) {
      return data.id is string;
    }

    // Entity Validation: FundAccount
    function isValidFundAccount(data) {
      return data.id is string;
    }

    // Match Collections
    match /devices/{deviceId} {
      allow read, write: if true;
    }

    match /leads/{leadId} {
      allow read, write: if true;
    }

    match /tradeIns/{tradeInId} {
      allow read, write: if true;
    }

    match /warrantyTickets/{ticketId} {
      allow read, write: if true;
    }

    match /invoices/{invoiceId} {
      allow read, write: if true;
    }

    match /users/{userId} {
      allow read, write: if true;
    }

    match /partners/{partnerId} {
      allow read, write: if true;
    }

    match /cashTransactions/{transId} {
      allow read, write: if true;
    }

    match /funds/{fundId} {
      allow read, write: if true;
    }

    match /settings/{settingId} {
      allow read, write: if true;
    }

    match /admins/{adminId} {
      allow read, write: if true;
    }

    match /test/{testId} {
      allow read, write: if true;
    }

    // Fallback Catch-All
    match /{document=**} {
      allow read, write: if true;
    }
  }
}

